#include <loom/application.h>

int main(int argc, char *argv[])
{
    loom::Application application(argc, argv);
#ifndef NDEBUG
    application.enableDevelopmentRuntime();
#endif
    // LOOM_APP_URI and LOOM_APP_ENTRY come from loom_enable_hot_reload, so
    // the URI has one definition. It used to be hardcoded here as well, leaving
    // two sources of truth with the CMake one referenced by nothing.
    return application.run(
        QStringLiteral(LOOM_APP_URI), QStringLiteral(LOOM_APP_ENTRY));
}
