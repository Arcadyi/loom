name: CI

on:
  push:
  pull_request:

# Generated by `loom new --ci github`. One step below is marked TODO: loom
# has no published release yet, so there is nothing to pin. Until it does, build
# and install loom from source and point LOOM_PREFIX at the install prefix.
#
# Only Linux runs here. Add macos-latest / windows-latest once you have actually
# built there -- a matrix entry that has never passed is a red X, not coverage.
jobs:
  desktop:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Qt
        uses: jurplel/install-qt-action@v4
        with:
          version: '6.11.*'
          modules: qtdeclarative
          cache: true

      - name: Install build tools
        run: sudo apt-get update && sudo apt-get install -y ninja-build

      # TODO: replace with your own way of obtaining loom, for example
      #   git clone https://github.com/<you>/loom && cd loom
      #   cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
      #   cmake --build build
      #   cmake --install build --prefix "$HOME/.local/loom"
      #   echo "LOOM_PREFIX=$HOME/.local/loom" >> "$GITHUB_ENV"
      - name: Install loom
        run: |
          echo "::error::Fill in the 'Install loom' step in .github/workflows/ci.yml"
          exit 1

      - name: Build
        run: "$LOOM_PREFIX/bin/loom build --config Release"

      - name: Test
        run: "$LOOM_PREFIX/bin/loom test --config Release"
