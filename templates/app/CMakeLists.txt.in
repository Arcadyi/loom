cmake_minimum_required(VERSION 3.22)

project(@LOOM_TARGET@ VERSION 0.1.0 LANGUAGES CXX)

# QuickControls2 is linked because qml/Main.qml imports QtQuick.Controls.
# Relying on Quick alone breaks a static Qt build and makes qmllint and
# qmlcachegen complain about an unresolved import.
find_package(Qt6 6.11 REQUIRED COMPONENTS Quick QuickControls2 Test)
# One package for both halves: the styling library behind `import Loom`, and the
# build and hot-reload tooling. `loom new` records the package belonging to the
# CLI that created this project so a direct IDE configure does not depend on the
# IDE inheriting the terminal's PATH. If that installation has moved, normal
# CMake package discovery remains the portable fallback.
#
# The hint names the host package, so a cross build has to ignore it: an
# Android or iOS application links loom's static libraries and needs the ones
# built for that target, which `loom build` puts on CMAKE_PREFIX_PATH.
set(_loom_generated_package_hint "@LOOM_CMAKE_PACKAGE_DIR@")
if(NOT CMAKE_CROSSCOMPILING
   AND EXISTS "${_loom_generated_package_hint}/loomConfig.cmake")
    find_package(loom @LOOM_VERSION@ CONFIG REQUIRED
        PATHS "${_loom_generated_package_hint}"
        NO_DEFAULT_PATH
    )
else()
    find_package(loom @LOOM_VERSION@ CONFIG REQUIRED)
endif()
unset(_loom_generated_package_hint)

# Do not let an unrelated or incomplete package fail later as an unexplained
# "Unknown CMake command" at loom_add_application.
if(NOT COMMAND loom_add_application)
    message(FATAL_ERROR
        "The loom package at '${loom_DIR}' does not provide loom_add_application. "
        "Select the package installed with loom @LOOM_VERSION@ or newer.")
endif()

qt_standard_project_setup(REQUIRES 6.11)

loom_add_application(@LOOM_TARGET@
    URI @LOOM_URI@
    ENTRY Main
    QML_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/qml"
    ASSET_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/assets"
    SOURCES src/main.cpp
    # Compiled into the binary for release, and watched by `loom dev` so an edit
    # repaints the running window without recreating the scene.
    DESIGN "${CMAKE_CURRENT_SOURCE_DIR}/design/tokens.json"
)

target_link_libraries(@LOOM_TARGET@ PRIVATE
    Qt6::QuickControls2
    loom::loom
    loom::loomplugin
)

# One identity across the platforms that ask for one. `loom deploy` and
# `loom dev` install and launch the Android package by the id in loom.json, so
# without the package name here the application ships as Qt's default
# org.qtproject.example.@LOOM_TARGET@ and neither can find what it just
# installed. Declared with the target rather than passed in by the CLI so a
# plain `cmake` configure produces the same identity `loom build` does.
set_target_properties(@LOOM_TARGET@ PROPERTIES
    MACOSX_BUNDLE TRUE
    MACOSX_BUNDLE_GUI_IDENTIFIER "@LOOM_APP_ID@"
    QT_ANDROID_PACKAGE_NAME "@LOOM_APP_ID@"
    WIN32_EXECUTABLE TRUE
)

# `loom deploy` drives this. Qt is not bundled -- see the note on
# loom_install_application for what was measured and why.
loom_install_application(TARGET @LOOM_TARGET@)

set(CPACK_PACKAGE_NAME "@LOOM_TARGET@")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME
    "@LOOM_TARGET@-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
if(WIN32)
    set(CPACK_GENERATOR "WIX")
elseif(APPLE)
    set(CPACK_GENERATOR "DragNDrop")
else()
    set(CPACK_GENERATOR "DEB")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "@LOOM_TARGET@ maintainers")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
endif()
include(CPack)

include(CTest)
if(BUILD_TESTING)
    qt_add_executable(@LOOM_TARGET@Tests
        tests/tst_smoke.cpp
    )
    target_link_libraries(@LOOM_TARGET@Tests PRIVATE Qt6::Test)
    # Same reason as the application target: a test target whose name matches a
    # build-tree directory cannot be linked.
    set_target_properties(@LOOM_TARGET@Tests PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    )
    add_test(NAME smoke COMMAND @LOOM_TARGET@Tests)
endif()
