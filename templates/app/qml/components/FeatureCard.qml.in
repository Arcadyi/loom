pragma ComponentBehavior: Bound
import Loom
import Loom.Controls
import QtQuick

// A Box rather than a Rectangle: `p-5` is real padding, and the height comes
// from the content instead of the hardcoded `implicitHeight: 176` this used to
// carry -- a number that was only ever right for the text it shipped with.
Box {
    id: card

    required property string description
    required property string eyebrow
    required property string heading
    property color accent: Loom.color.accent

    Lo.style: "@card p-5 hover:bg-surface-alt transition-colors"

    Col {
        width: card.availableWidth
        Lo.style: "gap-3"

        Rectangle {
            color: card.accent
            implicitWidth: 36
            implicitHeight: 5
            radius: height / 2
        }

        Text {
            Lo.style: "text-accent text-xs font-semibold"
            text: card.eyebrow.toUpperCase()
        }

        Text {
            Lo.style: "text-foreground text-lg font-semibold"
            text: card.heading
        }

        Text {
            Lo.style: "text-muted text-sm"
            width: card.availableWidth
            wrapMode: Text.WordWrap
            text: card.description
        }
    }
}
