import Loom
import QtQuick
import QtQuick.Controls

ApplicationWindow {
    id: window

    // Only what the automatic capture cannot reach. Properties of id-bearing
    // objects are saved and restored across a reload without being listed here;
    // the window's own geometry is not one, because it belongs to the window
    // rather than to any object inside the scene.
    function loomSaveState() {
        return {
            "theme": Loom.theme,
            "width": width,
            "height": height
        };
    }

    function loomRestoreState(state) {
        Loom.theme = state.theme ?? Loom.theme;
        width = state.width ?? width;
        height = state.height ?? height;
    }

    color: Loom.color.background
    minimumWidth: 420
    minimumHeight: 560
    width: 1100
    height: 720
    visible: true
    title: qsTr("@LOOM_DISPLAY_NAME@")

    // A Loader rather than `HomePage { }` on purpose: it is the seam hot reload
    // rebuilds. Editing anything the page is built from swaps what is inside
    // this Loader and leaves the window, its size and its position alone, where
    // an inline page would take the whole scene down with it. Keep bindings off
    // the loaded item -- they would point at the instance that gets replaced.
    Loader {
        anchors.fill: parent
        source: "pages/HomePage.qml"
    }
}
