import QtQuick
import QtQuick.Controls
import QtQuick.Layouts

ApplicationWindow {
    id: window

    property int count: 0

    function respinSaveState() {
        return {
            "count": count,
            "width": width,
            "height": height
        };
    }

    function respinRestoreState(state) {
        count = state.count ?? 0;
        width = state.width ?? width;
        height = state.height ?? height;
    }

    width: 960
    height: 640
    visible: true
    title: qsTr("@RESPIN_DISPLAY_NAME@")

    ColumnLayout {
        anchors.centerIn: parent
        spacing: 20

        Label {
            Layout.alignment: Qt.AlignHCenter
            text: qsTr("Your respin app is ready")
            font.pixelSize: 30
            font.weight: Font.DemiBold
        }

        Label {
            Layout.alignment: Qt.AlignHCenter
            text: qsTr("Edit qml/Main.qml and save to reload")
            opacity: 0.7
        }

        Button {
            Layout.alignment: Qt.AlignHCenter
            text: qsTr("Count: %1").arg(window.count)
            onClicked: window.count += 1
        }

    }

}
