import "pages"
import Loom
import QtQuick
import QtQuick.Controls

ApplicationWindow {
    id: window

    property int count: 0

    function loomSaveState() {
        return {
            "count": count,
            "theme": Loom.theme,
            "width": width,
            "height": height
        };
    }

    function loomRestoreState(state) {
        count = state.count ?? 0;
        Loom.theme = state.theme ?? Loom.theme;
        width = state.width ?? width;
        height = state.height ?? height;
    }

    color: Loom.color.background
    minimumWidth: 420
    minimumHeight: 560
    width: 1100
    height: 720
    visible: true
    title: qsTr("@LOOM_DISPLAY_NAME@")

    HomePage {
        anchors.fill: parent
        count: window.count
        onIncrementRequested: window.count += 1
    }
}
