pragma ComponentBehavior: Bound
import "../components"
import Loom
import Loom.Controls
import QtQuick
import QtQuick.Controls
import QtQuick.Layouts

Item {
    id: page

    // The page owns what the page shows. Nothing binds across the Loader that
    // holds it, which is what lets this file be rebuilt on its own: a property
    // the window bound to would be pointing at the replaced instance.
    property int count: 0

    Flickable {
        id: viewport

        anchors.fill: parent
        boundsBehavior: Flickable.StopAtBounds
        clip: true
        contentHeight: content.implicitHeight + 2 * Loom.space.s6
        contentWidth: width

        ScrollBar.vertical: ScrollBar {}

        ColumnLayout {
            id: content

            readonly property real edge: viewport.width < Loom.breakpoint.md
                ? Loom.space.s4 : Loom.space.s6

            x: Math.max(edge, (viewport.width - width) / 2)
            y: Loom.space.s6
            width: Math.min(1080, viewport.width - 2 * edge)
            spacing: Loom.space.s5

            RowLayout {
                Layout.fillWidth: true
                spacing: Loom.space.s3

                Rectangle {
                    Lo.style: "bg-accent rounded-lg"
                    implicitWidth: 40
                    implicitHeight: 40

                    Text {
                        Lo.style: "text-on-accent text-lg font-semibold center"
                        text: qsTr("L")
                    }
                }

                ColumnLayout {
                    spacing: 0

                    Text {
                        Lo.style: "text-foreground text-lg font-semibold"
                        text: qsTr("@LOOM_PROJECT_NAME@")
                    }

                    Text {
                        Lo.style: "text-muted text-xs"
                        text: qsTr("Built with Qt and Loom")
                    }
                }

                Item { Layout.fillWidth: true }

                Button {
                    text: Loom.dark ? qsTr("Light mode") : qsTr("Dark mode")
                    onClicked: Loom.theme = Loom.dark ? "light" : "dark"
                }
            }

            // A Box rather than a Rectangle with an inset child: `p-6` is real
            // padding here, and the height follows the content on its own. The
            // Rectangle form needed an inner item anchored with margins plus
            // `implicitHeight: heroContent.implicitHeight + 2 * Loom.space.s6`
            // restated at every call site.
            Box {
                id: hero

                // `syncing` is declared in design/tokens.json and supplied once
                // here. Being a group as well as a state is what lets anything
                // inside react to it without restating the condition -- see the
                // label beside the button.
                Lo.group: "hero"
                Lo.states: ({ syncing: page.count > 0 })
                Lo.style: "@card p-6 border syncing:border-warning"
                Layout.fillWidth: true

                ColumnLayout {
                    id: heroContent

                    width: hero.availableWidth
                    spacing: Loom.space.s3

                    Text {
                        Lo.style: "text-accent text-sm font-semibold"
                        text: qsTr("YOUR STARTING POINT")
                    }

                    Text {
                        Lo.style: "text-foreground text-3xl font-semibold"
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        text: qsTr("Your loom app is ready")
                    }

                    Text {
                        Lo.style: "text-muted text-lg"
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        text: qsTr("This starter already has responsive structure, "
                            + "design tokens, hot reload, tests, and editor tooling.")
                    }

                    RowLayout {
                        Layout.topMargin: Loom.space.s2
                        spacing: Loom.space.s3

                        Button {
                            text: qsTr("Count: %1").arg(page.count)
                            onClicked: page.count += 1
                        }

                        // Reads the card's state through the group, so the
                        // condition is written once. Without it this would be
                        // the same ternary, copied.
                        Text {
                            Lo.style: "text-warning text-sm hidden"
                                + " group-syncing/hero:visible"
                            text: qsTr("unsaved changes")
                        }
                    }
                }
            }

            Text {
                Lo.style: "text-foreground text-xl font-semibold"
                Layout.topMargin: Loom.space.s2
                text: qsTr("What is ready")
            }

            GridLayout {
                Layout.fillWidth: true
                columns: width >= Loom.breakpoint.md ? 3 : 1
                columnSpacing: Loom.space.s4
                rowSpacing: Loom.space.s4

                FeatureCard {
                    Layout.fillWidth: true
                    description: qsTr("Edit any QML file and keep application state "
                        + "while the scene reloads.")
                    eyebrow: qsTr("Fast loop")
                    heading: qsTr("Hot reload")
                }

                FeatureCard {
                    Layout.fillWidth: true
                    accent: Loom.color.warning
                    description: qsTr("Use typed Loom tokens or utility classes backed "
                        + "by design/tokens.json.")
                    eyebrow: qsTr("One system")
                    heading: qsTr("Design tokens")
                }

                FeatureCard {
                    Layout.fillWidth: true
                    accent: Loom.color.success
                    description: qsTr("CMake presets, qmllint, smoke tests, formatting, "
                        + "and CLion completion are pre-wired.")
                    eyebrow: qsTr("Tooling")
                    heading: qsTr("Ready to ship")
                }
            }

            Box {
                id: nextStepsCard

                Lo.style: "bg-surface-alt border border-outline rounded-lg p-5"
                Layout.fillWidth: true

                ColumnLayout {
                    id: nextSteps

                    width: nextStepsCard.availableWidth
                    spacing: Loom.space.s2

                    Text {
                        Lo.style: "text-foreground text-sm font-semibold"
                        text: qsTr("Make it yours")
                    }

                    Text {
                        Lo.style: "text-muted text-sm"
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        text: qsTr("Start in qml/pages/HomePage.qml, extract reusable "
                            + "pieces under qml/components, and tune your palette in "
                            + "design/tokens.json.")
                    }
                }
            }
        }
    }
}
