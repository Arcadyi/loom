{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Desktop Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.respin/build/preset-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Desktop Release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/.respin/build/preset-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
