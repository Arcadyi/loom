@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# QmlPrivate is respin_runtime's own private dependency, but a STATIC library
# records even PRIVATE links as $<LINK_ONLY:...> in its interface, so the
# consumer still has to be able to resolve the imported target.
find_dependency(Qt6 6.11 COMPONENTS Core Gui Network Qml QmlPrivate Quick)

include("${CMAKE_CURRENT_LIST_DIR}/respinTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/respinFunctions.cmake")

check_required_components(respin)
