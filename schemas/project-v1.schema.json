{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arcadyi/loom/main/schemas/project-v1.schema.json",
  "title": "loom project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "qt",
    "applications"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "defaultApplication": {
          "type": "string",
          "minLength": 1,
          "description": "Target of the application commands act on when --app is not given. Without it, a project with several applications requires --app."
        }
      }
    },
    "qt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "6.11"
        }
      }
    },
    "applications": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "target",
          "id",
          "uri",
          "entry",
          "qmlRoots",
          "assetRoots",
          "platforms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "qmlRoots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assetRoots": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "enum": [
                "desktop",
                "android",
                "ios",
                "embedded"
              ]
            }
          }
        }
      }
    }
  }
}
