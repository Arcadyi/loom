{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arcadyi/loom/master/schemas/design-v2.schema.json",
  "title": "Loom design system v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": { "$ref": "#/$defs/colors" },
        "space": { "$ref": "#/$defs/nonNegativeNumbers" },
        "textSizes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/textStyle" } },
        "fontWeights": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 1000 } },
        "fontFamilies": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] } },
        "tracking": { "$ref": "#/$defs/tracking" },
        "radius": { "$ref": "#/$defs/boundedNonNegativeNumbers" },
        "shadows": { "type": "object", "additionalProperties": { "$ref": "#/$defs/shadow" } },
        "opacity": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
        "durations": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3600000 } },
        "easings": { "$ref": "#/$defs/easings" },
        "breakpoints": { "$ref": "#/$defs/positiveIntegers" },
        "containers": { "$ref": "#/$defs/positiveIntegers" }
      }
    },
    "themes": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "$ref": "#/$defs/theme" } },
    "theme": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "light": { "type": "string", "minLength": 1, "not": { "const": "system" } },
        "dark": { "type": "string", "minLength": 1, "not": { "const": "system" } }
      }
    },
    "styles": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "type": "string" } },
    "lint": { "type": "object", "additionalProperties": false, "properties": { "arbitraryValues": { "enum": ["allow", "warn", "deny"] } } },
    "iconRoot": { "type": "string" }
  },
  "$defs": {
    "numbers": { "type": "object", "additionalProperties": { "type": "number" } },
    "nonNegativeNumbers": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "boundedNonNegativeNumbers": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1000000 } },
    "tracking": { "type": "object", "additionalProperties": { "type": "number", "minimum": -10, "maximum": 10 } },
    "positiveIntegers": { "type": "object", "additionalProperties": { "type": "integer", "exclusiveMinimum": 0 } },
    "easings": { "type": "object", "additionalProperties": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number" }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number" }], "minItems": 4, "maxItems": 4 } },
    "colors": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] } },
    "textStyle": { "type": "object", "additionalProperties": false, "required": ["size", "lineHeight"], "properties": { "size": { "type": "number", "exclusiveMinimum": 0 }, "lineHeight": { "type": "number", "exclusiveMinimum": 0 } } },
    "shadow": { "type": "object", "additionalProperties": false, "properties": { "color": { "type": "string" }, "offsetX": { "type": "number" }, "offsetY": { "type": "number" }, "blur": { "type": "number", "minimum": 0 }, "spread": { "type": "number" } } },
    "themeTokens": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "type": "string" } },
        "space": { "$ref": "#/$defs/nonNegativeNumbers" },
        "textSizes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/textStyle" } },
        "fontWeights": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 1000 } },
        "fontFamilies": { "type": "object", "additionalProperties": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] } },
        "tracking": { "$ref": "#/$defs/tracking" },
        "radius": { "$ref": "#/$defs/boundedNonNegativeNumbers" },
        "shadows": { "type": "object", "additionalProperties": { "$ref": "#/$defs/shadow" } },
        "opacity": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
        "durations": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3600000 } },
        "easings": { "$ref": "#/$defs/easings" }
      }
    },
    "theme": { "type": "object", "additionalProperties": false, "properties": { "extends": { "type": "string", "minLength": 1 }, "dark": { "type": "boolean" }, "tokens": { "$ref": "#/$defs/themeTokens" } } }
  }
}
